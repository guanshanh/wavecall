# Build stage
FROM golang:1.22-alpine AS builder

WORKDIR /build
COPY server/ .
RUN go mod download
RUN CGO_ENABLED=0 GOOS=linux go build -o wavecall-server ./cmd/server

# Runtime stage
FROM alpine:3.19

RUN apk --no-cache add ca-certificates
WORKDIR /app
COPY --from=builder /build/wavecall-server .

EXPOSE 8080

ENTRYPOINT ["./wavecall-server"]
CMD ["-port", "8080"]
